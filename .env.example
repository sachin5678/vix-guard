# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# 1) Message @BotFather on Telegram -> /newbot -> copy the token here.
# 2) Send /start to your new bot.
# 3) Run `python -m vixguard whoami` and copy the chat ID here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# One or more chat IDs are allowed, comma-separated (groups start with -):
# TELEGRAM_CHAT_ID=123456789,-1001234567890

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------
# NIFTY STBT is stopped when India VIX is ABOVE this level.
NIFTY_MAX_VIX=22
# SENSEX STBT is stopped when India VIX is BELOW this level.
SENSEX_MIN_VIX=11

# ---------------------------------------------------------------------------
# Behaviour (optional)
# ---------------------------------------------------------------------------
# Seconds between checks during market hours (minimum 15).
POLL_SECONDS=300
# Where the last regime is remembered.
STATE_FILE=state.json
# Send a status message when the bot starts.
ANNOUNCE_ON_START=true
# Send a plan message before the open, once per trading day.
DAILY_DIGEST=true
# Earliest time for the daily digest (IST).
DIGEST_AFTER=09:10
# Market window (IST, Mon-Fri). Checks happen only inside this window.
MARKET_OPEN=09:05
MARKET_CLOSE=15:40
# Optional: rotating log file (useful for a server).
LOG_FILE=
